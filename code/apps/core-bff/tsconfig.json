{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["../../services/session-service/node_modules/@types"],
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "test/**/*"]
}
