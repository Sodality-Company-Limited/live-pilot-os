# Session Service Environment Configuration (DigitalOcean Droplet Deployment)
# Copy to .env.session-service or load into Docker Compose

# Process & Network
NODE_ENV=production
PORT=3004
HOST=0.0.0.0

# Database Connectivity (PostgreSQL 16 - dedicated session schema)
# Must connect to the internal Docker bridge network or private DO VPC
DATABASE_URL=postgres://livepilot_session:change-me-in-production@livepilot-postgres:5432/livepilot?sslmode=disable
DB_POOL_MIN=2
DB_POOL_MAX=10

# Messaging Connectivity (NATS JetStream 2.10)
NATS_URL=nats://livepilot-nats:4222
NATS_TOKEN=change-me-to-high-entropy-token-in-production

# Service Logging & Diagnostics
LOG_LEVEL=info
