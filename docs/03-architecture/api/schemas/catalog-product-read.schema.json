{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.livepilot.invalid/catalog/product-read.v1.schema.json",
  "title": "Catalog Product Read v1",
  "type": "object",
  "required": ["tenant_id", "correlation_id", "causation_id", "schema_version", "producer", "occurred_at", "product_id", "sku", "name", "size", "selling_points", "usage", "price_minor", "currency", "stock_display", "catalog_version", "fact_revision", "freshness_expires_at", "freshness_state", "status", "mode"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "causation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "producer": {"type": "string", "const": "catalog-service"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "product_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sku": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "size": {"type": "string", "minLength": 1, "maxLength": 128},
    "selling_points": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "usage": {"type": "string", "minLength": 1, "maxLength": 2000},
    "price_minor": {"type": "integer", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "stock_display": {"type": "integer", "minimum": 0},
    "catalog_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "fact_revision": {"type": "integer", "minimum": 1},
    "freshness_expires_at": {"type": "string", "format": "date-time"},
    "freshness_state": {"type": "string", "enum": ["fresh", "stale", "unknown"]},
    "as_of": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["approved", "stale", "withdrawn"]},
    "approved_claims": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "mode": {"type": "string", "enum": ["SIMULATED", "SANDBOX", "CONFIRMED"]}
  },
  "additionalProperties": false
}
