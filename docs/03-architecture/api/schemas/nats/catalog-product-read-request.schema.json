{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.livepilot.invalid/nats/catalog-product-read-request.schema.json",
  "title": "livepilot.v1.catalog.product.read.request",
  "description": "Versioned NATS query envelope and selector contract for livepilot.v1.catalog.product.read.request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "message_kind",
    "subject",
    "schema_version",
    "occurred_at",
    "producer",
    "tenant_id",
    "correlation_id",
    "mode",
    "data"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "message_kind": {
      "type": "string",
      "const": "query"
    },
    "subject": {
      "type": "string",
      "const": "livepilot.v1.catalog.product.read.request"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "causation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": ["SIMULATED", "SANDBOX", "CONFIRMED"]
    },
    "headers": {
      "$ref": "#/$defs/MessageHeaders"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["product_id"] },
        { "required": ["sku"] }
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "freshness_requirement": {
          "type": "string",
          "enum": ["fresh", "any"]
        },
        "include_claims": {
          "type": "boolean"
        },
        "include_evidence": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "MessageHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Nats-Msg-Id",
        "X-Correlation-Id",
        "X-Tenant-Id",
        "X-Schema-Version",
        "X-Producer",
        "X-Traceparent",
        "X-Mode"
      ],
      "properties": {
        "Nats-Msg-Id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "X-Correlation-Id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "X-Causation-Id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "X-Idempotency-Key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "X-Tenant-Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "X-Session-Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "X-Schema-Version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "X-Producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "X-Traceparent": {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[0-3]$"
        },
        "X-Mode": {
          "type": "string",
          "enum": ["SIMULATED", "SANDBOX", "CONFIRMED"]
        }
      }
    }
  }
}
