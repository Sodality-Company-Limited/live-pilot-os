# Approval & Control Service Production Environment Configuration Template
# Target: DigitalOcean Droplets (Private livepilot network; zero public ports)
# Conforms to G-APPR-007, digitalocean-droplets-sot.md, and runtime-topology-sot.md
# Store at /opt/live-pilot-os/infra/approval-control-service.env (root-owned, chmod 600). NEVER commit real secrets.

# Process & Network Binding
NODE_ENV=production
APP_ENV=prod
PORT=8086
HOST=0.0.0.0
LOG_LEVEL=info

# Execution Mode
APPROVAL_EXECUTION_MODE=PRODUCTION
PLATFORM_ADAPTER_MODE=simulated

# PostgreSQL 16 (Private livepilot network; authoritative writer for approval & control schema)
DATABASE_URL=postgres://livepilot:REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS@postgres:5432/livepilot?sslmode=disable
POSTGRES_USER=livepilot
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
POSTGRES_DB=livepilot

# NATS JetStream 2.10 (Private livepilot network; command/decision consumer and outbox events)
NATS_URL=nats://nats:4222
NATS_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Outbox Publisher Configuration
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
