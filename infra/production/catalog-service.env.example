# Catalog Service Production Environment Configuration Template
# Target: DigitalOcean Droplet (or App Platform internal worker)
# Copy to /opt/livepilot/catalog-service.env (root-owned, chmod 600). NEVER commit real secrets.

# Process & Internal Network Binding (zero public ports)
NODE_ENV=production
PORT=3006
HOST=0.0.0.0
APP_ENV=prod
LOG_LEVEL=info

# Execution & Adapter Mode Visibility (simulated prevents external marketplace mutation)
PLATFORM_ADAPTER_MODE=simulated
CATALOG_EXECUTION_MODE=SIMULATED

# PostgreSQL 16 (Private livepilot-infra network; authoritative writer for catalog.* schema)
# Replace placeholder credentials from Vault / DO Secrets before apply.
DATABASE_URL=postgres://livepilot_catalog:REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS@postgres:5432/livepilot?sslmode=disable

# NATS JetStream 2.10 (Private livepilot-infra network; catalog request/reply + outbox events)
NATS_URL=nats://nats:4222
NATS_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
