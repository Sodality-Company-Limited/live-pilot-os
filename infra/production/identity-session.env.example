# Identity and Session Service Production Environment Configuration
# DigitalOcean Droplet Deployment

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Connection (authoritative writer for identity_session schema)
DATABASE_URL=postgres://livepilot_identity:secret@livepilot-postgres:5432/livepilot?sslmode=disable
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security and Cookie Domain
SESSION_SECRET_SALT=change-me-to-high-entropy-random-salt-in-production
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=.livepilot.io

# Mode Guard: SIMULATED (Local/Hackathon) or OIDC (Enterprise Production)
AUTH_MODE=SIMULATED
ALLOW_SIMULATED_LOGINS=true
