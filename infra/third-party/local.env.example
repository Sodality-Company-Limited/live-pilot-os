# Local development uses mock/simulated adapters by default.
APP_ENV=local
PLATFORM_ADAPTER_MODE=simulated
DEMO_MODE=true
DEMO_SCENARIO=opportunity
FRONTEND_MOCK_SIGNALS=true
BACKEND_MOCK_PRODUCTS=true
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
SITE_URL=http://localhost:3000
AI_PROVIDER=fixture
OPENAI_API_KEY=DISABLED_IN_LOCAL
OPENAI_MODEL=disabled
JEV_PROMPT_REVISION=jev-prompt-v1
JEV_SCHEMA_REVISION=jev-schema-v1
RESEND_ENABLED=false
RESEND_FROM_EMAIL="LivePilot Local <local@example.invalid>"
RESEND_API_KEY=DISABLED_IN_LOCAL
