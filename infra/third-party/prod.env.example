# LivePilot third-party production configuration template.
# Copy to a root-owned secret file; never commit real values.

# Runtime boundary
APP_ENV=prod
PLATFORM_ADAPTER_MODE=simulated

# Public topology
FRONTEND_URL=https://REPLACE_WITH_LIVEPILOT_DOMAIN
API_PUBLIC_URL=https://api.REPLACE_WITH_LIVEPILOT_DOMAIN
SITE_URL=https://REPLACE_WITH_LIVEPILOT_DOMAIN

# TikTok Login Kit
TIKTOK_LOGIN_CLIENT_KEY=REPLACE_WITH_TIKTOK_CLIENT_KEY
TIKTOK_LOGIN_CLIENT_SECRET=REPLACE_WITH_TIKTOK_CLIENT_SECRET
TIKTOK_AUTH_BASE_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_LOGIN_SSO_CALLBACK_URI=${API_PUBLIC_URL}/v1/auth/sso/tiktok/callback
TIKTOK_LOGIN_REDIRECT_URI=${FRONTEND_URL}/auth/callback

# TikTok Shop Partner / platform adapter
TIKTOK_SHOP_PARTNER_APP_KEY=REPLACE_WITH_TIKTOK_PARTNER_APP_KEY
TIKTOK_SHOP_PARTNER_APP_SECRET=REPLACE_WITH_TIKTOK_PARTNER_APP_SECRET
TIKTOK_SHOP_PARTNER_AUTH_HOST=https://auth.tiktok-shops.com
TIKTOK_SHOP_PARTNER_AUTHORIZE_URL=https://partner.tiktokshop.com/open/authorize
TIKTOK_SHOP_PARTNER_SERVICE_ID=REPLACE_WITH_SERVICE_ID
TIKTOK_SHOP_PARTNER_REDIRECT_URI=${API_PUBLIC_URL}/v1/platform/tiktok/shop/callback

# Transactional email
RESEND_FROM_EMAIL="LivePilot Notifications <noreply@REPLACE_WITH_LIVEPILOT_DOMAIN>"
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
