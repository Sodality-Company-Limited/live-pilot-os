{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soda-os.dev/schemas/action-step.schema.json",
  "title": "ActionStep",
  "description": "Schema for Soda OS step-level executable micro-task action definition",
  "type": "object",
  "required": [
    "step_id",
    "goal_id",
    "objective",
    "persona",
    "touch_map",
    "verification_command",
    "completion_gate",
    "stop_condition"
  ],
  "properties": {
    "step_id": {
      "type": "integer",
      "minimum": 1
    },
    "goal_id": {
      "type": "string",
      "pattern": "^G-[A-Za-z0-9_-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "persona": {
      "type": "string",
      "minLength": 3
    },
    "touch_map": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_command": {
      "type": "string",
      "minLength": 3
    },
    "completion_gate": {
      "type": "string",
      "minLength": 3
    },
    "stop_condition": {
      "type": "string",
      "minLength": 3
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "default": 300000
    },
    "commit_message": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
