{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soda.dev/schemas/model-provenance.schema.json",
  "title": "Soda OS Cryptographic Model Provenance Schema",
  "description": "Cryptographic schema governing trained model checkpoint manifests, LoRA adapter weights, tokenizer configs, dataset lineage, and tamper-evident HMAC audit ledgers.",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "base_checkpoint",
    "source_revision",
    "generated_at",
    "dataset_lineage",
    "tokenizer",
    "training_config",
    "evaluation_metrics",
    "artifacts",
    "block_index",
    "previous_block_hash",
    "hmac_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version (must be 1 for v1 provenance contract)"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique identifier of the model checkpoint or LoRA adapter"
    },
    "base_checkpoint": {
      "type": "string",
      "minLength": 5,
      "description": "Base foundational model name or checkpoint commit digest"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "40-character Git commit SHA of the training source code"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp when provenance manifest was sealed"
    },
    "dataset_lineage": {
      "type": "object",
      "description": "Cryptographic SHA-256 byte hashes of training curriculum datasets",
      "required": ["stage2_scene_graphs_sha256", "stage4_trajectories_sha256", "stage5_preferences_sha256"],
      "properties": {
        "stage1_taxonomy_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "stage2_scene_graphs_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "stage3_heuristics_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "stage4_trajectories_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "stage5_preferences_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "stage6_adversarial_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
    },
    "tokenizer": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "training_config": {
      "type": "object",
      "required": ["lora_rank", "lora_alpha", "learning_rate", "beta", "epochs", "random_seed"],
      "properties": {
        "lora_rank": { "type": "integer", "minimum": 1, "maximum": 128 },
        "lora_alpha": { "type": "integer", "minimum": 1, "maximum": 256 },
        "learning_rate": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 0.1 },
        "beta": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "epochs": { "type": "integer", "minimum": 1 },
        "random_seed": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "evaluation_metrics": {
      "type": "object",
      "required": ["json_schema_conformance", "dpo_win_rate", "ece", "brier", "auroc", "hcer"],
      "properties": {
        "json_schema_conformance": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "dpo_win_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "ece": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "brier": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "auroc": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "hcer": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "byte_size": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "block_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-indexed sequential position in the model provenance ledger"
    },
    "previous_block_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "SHA-256 block hash of previous ledger entry, or 64 zeroes for genesis block"
    },
    "hmac_signature": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "HMAC-SHA256 signature calculated over serialized block payload"
    }
  },
  "additionalProperties": false
}
