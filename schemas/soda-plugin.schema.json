{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soda-os.dev/schemas/soda-plugin.schema.json",
  "title": "SodaPluginManifest",
  "type": "object",
  "required": ["name", "version", "description", "capabilities"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "command": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
