{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soda.dev/schemas/ui-scene-graph.schema.json",
  "title": "Soda OS UI Scene Graph Directed Acyclic Graph (DAG) Schema",
  "description": "Canonical schema governing deterministic, acyclic UI scene graphs synthesized from multimodal vision perception and OCR token fusion.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "viewport",
    "timestamp",
    "nodes",
    "edges",
    "root_node_id",
    "topological_order",
    "sha256_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version (1 for canonical UI Scene Graph v1)"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^SG-[0-9]{4}-[0-9]{3,}$",
      "description": "Unique deterministic identifier for the scene graph (e.g. SG-0001-001)"
    },
    "viewport": {
      "type": "object",
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "enum": ["desktop", "tablet", "mobile", "custom"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp when scene graph was synthesized"
    },
    "root_node_id": {
      "type": "string",
      "description": "ID of root container node (typically ScreenRoot)"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "component_type",
          "category",
          "bbox",
          "bbox_normalized",
          "z_index",
          "interaction_state"
        ],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "component_type": {
            "type": "string",
            "enum": [
              "ScreenRoot",
              "ModalDialog",
              "CardContainer",
              "DrawerPanel",
              "SidebarNavigation",
              "HeaderBar",
              "FooterBar",
              "AccordionSection",
              "PrimaryButton",
              "SecondaryButton",
              "IconButton",
              "CheckboxControl",
              "RadioGroupControl",
              "SwitchToggle",
              "SliderControl",
              "TextInputField",
              "TextAreaField",
              "SelectDropdown",
              "DatePickerField",
              "SearchBarInput",
              "FileUploadZone",
              "HeadingTypography",
              "BodyTypography",
              "BadgePill",
              "AvatarImage",
              "IconGlyph",
              "TableViewGrid",
              "MetricStatCard",
              "AlertBannerToast",
              "BreadcrumbTrail",
              "TabBarStrip",
              "PaginationControl"
            ]
          },
          "category": {
            "type": "string",
            "enum": ["container", "control", "input", "display", "data_feedback", "navigation"]
          },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox_normalized": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "minItems": 4,
            "maxItems": 4
          },
          "z_index": { "type": "integer" },
          "text_content": { "type": ["string", "null"] },
          "visual_properties": { "type": "object" },
          "interaction_state": {
            "type": "string",
            "enum": ["default", "hover", "focus", "active", "disabled", "error", "loading"]
          },
          "aria": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relationship"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relationship": {
            "type": "string",
            "enum": ["parent_child", "sibling", "visual_containment", "z_index_layer"]
          },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "topological_order": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Kahn algorithm topological sort sequence of node IDs"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Cryptographic SHA-256 digest over canonicalized scene graph"
    }
  },
  "additionalProperties": false
}
